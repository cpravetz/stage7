{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "dom"],
    "outDir": "./dist",
    "rootDir": "./",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@stage7-nextgen/shared": ["./shared-nextgen/src"],
      "@stage7-nextgen/shared/*": ["./shared-nextgen/src/*"],
      "@stage7-nextgen/artifacts": ["./services/artifacts/src"],
      "@stage7-nextgen/artifacts/*": ["./services/artifacts/src/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": [
    "services/**/*",
    "shared/src/**/*",
    "errorhandler/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "services/gateway/**/*"
  ]
}
