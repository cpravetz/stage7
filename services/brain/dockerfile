# Build on top of pre-built base image
FROM cktmcs:base

# Copy service package.json first for workspace registration
COPY services/brain/package.json ./services/brain/

# Install service dependencies
RUN npm install --legacy-peer-deps --workspace=services/brain

# Copy service source code
COPY services/brain/ ./services/brain/

# Build the service
RUN npm run build --workspace=services/brain

# Set working directory to the service's folder
WORKDIR /usr/src/app/services/brain

EXPOSE 5070

CMD ["node", "dist/Brain.js"]
