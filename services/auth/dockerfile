FROM node:22-alpine

RUN apk add --no-cache python3 make g++ vips-dev

WORKDIR /usr/src/app

COPY package*.json ./
COPY shared-nextgen/package*.json ./shared-nextgen/
COPY services/auth/package*.json ./services/auth/
COPY services/auth/tsconfig.json ./services/auth/
COPY shared-nextgen/tsconfig.json ./shared-nextgen/
COPY services/auth/src ./services/auth/src/

RUN --mount=type=cache,target=/root/.npm npm ci --legacy-peer-deps --ignore-scripts

COPY shared-nextgen/src ./shared-nextgen/src/

RUN cd shared-nextgen && npx tsc
RUN cd services/auth && rm -rf dist && npx tsc

WORKDIR /usr/src/app/services/auth

EXPOSE 4300

CMD ["node", "dist/index.js"]