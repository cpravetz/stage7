FROM node:22-alpine

RUN apk add --no-cache python3 make g++ vips-dev

WORKDIR /usr/src/app

COPY package*.json ./
COPY shared-nextgen/package*.json ./shared-nextgen/
COPY services ./services

RUN npm install --legacy-peer-deps

COPY shared-nextgen ./shared-nextgen
COPY services/mcp-runtime ./services/mcp-runtime

RUN cd shared-nextgen && npm run build
RUN cd services/mcp-runtime && rm -rf dist && npm run build

WORKDIR /usr/src/app/services/mcp-runtime

EXPOSE 3300

CMD ["node", "dist/index.js"]
