FROM node:22-alpine

RUN apk add --no-cache python3 make g++ vips-dev

WORKDIR /usr/src/app

COPY package*.json ./
COPY shared-nextgen/package*.json ./shared-nextgen/
COPY services/agent-runtime/package*.json ./services/agent-runtime/
COPY services/artifacts/package*.json ./services/artifacts/
COPY services/agent-runtime/tsconfig.json ./services/agent-runtime/
COPY services/artifacts/tsconfig.json ./services/artifacts/
COPY shared-nextgen/tsconfig.json ./shared-nextgen/
COPY services/agent-runtime/src ./services/agent-runtime/src/
COPY services/artifacts/src ./services/artifacts/src/

RUN --mount=type=cache,target=/root/.npm npm ci --legacy-peer-deps --ignore-scripts

COPY shared-nextgen/src ./shared-nextgen/src/

RUN cd shared-nextgen && npx tsc
RUN cd services/artifacts && rm -rf dist && npx tsc
RUN cd services/agent-runtime && rm -rf dist && npx tsc

WORKDIR /usr/src/app/services/agent-runtime

EXPOSE 3400

CMD ["node", "dist/index.js"]