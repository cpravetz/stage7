# Build on top of pre-built base image
FROM cktmcs:base

# Copy service package.json first for workspace registration
COPY services/agentset/package.json ./services/agentset/

# Install service dependencies
RUN npm install --legacy-peer-deps --workspace=services/agentset

# Copy service source code
COPY services/agentset/ ./services/agentset/

# Build the service
RUN npm run build --workspace=services/agentset

# Set working directory to the service's folder
WORKDIR /usr/src/app/services/agentset

EXPOSE 5100

CMD ["node", "dist/AgentSet.js"]
