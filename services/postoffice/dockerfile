# Build on top of pre-built base image
FROM cktmcs:base

# Copy service package.json first for workspace registration
COPY services/postoffice/package.json ./services/postoffice/

# Install service dependencies
RUN npm install --legacy-peer-deps --workspace=services/postoffice

# Copy service source code
COPY services/postoffice/ ./services/postoffice/

# Build the service
RUN npm run build --workspace=services/postoffice

# Set working directory to the service's folder
WORKDIR /usr/src/app/services/postoffice

EXPOSE 5020

CMD ["node", "dist/PostOffice.js"]
