# Build on top of pre-built base image
FROM cktmcs:base

# Copy service package.json first for workspace registration
COPY services/engineer/package.json ./services/engineer/

# Install service dependencies
RUN npm install --legacy-peer-deps --workspace=services/engineer

# Copy service source code
COPY services/engineer/ ./services/engineer/

# Build the service
RUN npm run build --workspace=services/engineer

# Set working directory to the service's folder
WORKDIR /usr/src/app/services/engineer

EXPOSE 5050

CMD ["node", "dist/Engineer.js"]
