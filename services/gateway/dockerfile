FROM node:22-alpine

RUN apk add --no-cache python3 make g++ vips-dev

WORKDIR /usr/src/app

COPY package*.json ./
COPY shared-nextgen/package*.json ./shared-nextgen/
COPY services/gateway/package*.json ./services/gateway/
COPY services/gateway/tsconfig.json ./services/gateway/
COPY shared-nextgen/tsconfig.json ./shared-nextgen/
COPY services/gateway/src ./services/gateway/src/

RUN npm install --legacy-peer-deps --ignore-scripts

COPY shared-nextgen/src ./shared-nextgen/src/

RUN cd shared-nextgen && npx tsc
RUN cd services/gateway && rm -rf dist && npx tsc

WORKDIR /usr/src/app/services/gateway

EXPOSE 3000

CMD ["node", "dist/index.js"]