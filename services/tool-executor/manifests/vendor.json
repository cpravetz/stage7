{
  "id": "vendor",
  "name": "Vendor API",
  "description": "Integrate with external SaaS systems: Jira, Confluence, Slack, GitHub",
  "type": "native",
  "manifest": {
    "executor": "vendor",
    "codeFile": "vendor.js",
    "configSchema": {
      "type": "object",
      "properties": {
        "apiKey": {
          "type": "string",
          "title": "API Key",
          "description": "Vendor API key",
          "sensitive": true,
          "required": false,
          "envVar": "VENDOR_API_KEY",
          "label": "API Key"
        },
        "token": {
          "type": "string",
          "title": "Token",
          "description": "Vendor authentication token",
          "sensitive": true,
          "required": false,
          "envVar": "VENDOR_TOKEN",
          "label": "Token"
        }
      },
      "required": []
    }
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "vendor": { "type": "string", "enum": ["jira", "confluence", "slack", "github"] },
      "operation": { "type": "string", "default": "query" },
      "input": { "type": "object" },
      "idempotencyKey": { "type": "string" },
      "lookupUrl": { "type": "string" }
    },
    "required": ["vendor", "operation"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "data": { "type": "object" },
      "error": { "type": "string" },
      "durationMs": { "type": "number" },
      "idempotencyKey": { "type": "string" }
    },
    "required": ["success"]
  },
  "isSkill": false
}