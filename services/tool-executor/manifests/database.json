{
  "id": "database",
  "name": "Database",
  "description": "Execute SQL queries against SQLite, PostgreSQL, or MySQL databases",
  "type": "native",
  "manifest": {
    "executor": "database",
    "codeFile": "database.js",
    "configSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "title": "Host",
          "description": "Database host",
          "required": false,
          "configKey": "db.host",
          "label": "Host"
        },
        "port": {
          "type": "integer",
          "title": "Port",
          "description": "Database port",
          "required": false,
          "configKey": "db.port",
          "label": "Port"
        },
        "database": {
          "type": "string",
          "title": "Database",
          "description": "Database name",
          "required": false,
          "configKey": "db.database",
          "label": "Database"
        },
        "username": {
          "type": "string",
          "title": "Username",
          "description": "Database username",
          "required": false,
          "configKey": "db.username",
          "label": "Username"
        },
        "password": {
          "type": "string",
          "title": "Password",
          "description": "Database password",
          "sensitive": true,
          "required": false,
          "configKey": "db.password",
          "label": "Password"
        },
        "connectionString": {
          "type": "string",
          "title": "Connection String",
          "description": "Full database connection string",
          "required": false,
          "configKey": "db.connectionString",
          "label": "Connection String"
        }
      },
      "required": []
    }
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "engine": { "type": "string", "enum": ["sqlite", "postgres", "mysql"], "default": "sqlite" },
      "connectionString": { "type": "string" },
      "host": { "type": "string" },
      "port": { "type": "integer" },
      "database": { "type": "string" },
      "username": { "type": "string" },
      "password": { "type": "string" },
      "query": { "type": "string" },
      "params": { "type": "array" },
      "timeoutMs": { "type": "integer", "default": 30000 }
    },
    "required": ["query"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "rows": { "type": "array" },
      "columns": { "type": "array" },
      "rowCount": { "type": "integer" },
      "error": { "type": "string" },
      "durationMs": { "type": "number" }
    },
    "required": ["success"]
  },
  "isSkill": false
}