  {
    id: 'career_reset',
    name: 'Reset Workspace',
    description:
      'Reset the career coach workspace. Supports partial resets (specific modules) or a full wipe. Always archives the previous state before destructive resets.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const scope = input.scope || 'full'; // full, profile, applications, interviews, outcomes, all_data
const confirm = input.confirm !== false;
const archive = input.archive !== false;
const profileId = input.profileId || 'default';

if (!confirm) {
  console.log(JSON.stringify({ success: false, error: 'Reset requires confirm=true' }));
  process.exit(0);
}

const dirs = ['profiles', 'resumes', 'applications', 'cover_letters', 'interviews', 'outcomes', 'reports'];
let targets = [];
if (scope === 'full' || scope === 'all_data') {
  targets = dirs;
} else if (scope === 'profile') {
  targets = ['profiles'];
} else if (scope === 'applications') {
  targets = ['applications'];
} else if (scope === 'interviews') {
  targets = ['interviews'];
} else if (scope === 'outcomes') {
  targets = ['outcomes'];
}

const archived = [];
if (archive) {
  const archiveDir = path.join(baseDir, '.archive');
  fs.mkdirSync(archiveDir, { recursive: true });
  for (const d of targets) {
    const src = path.join(baseDir, d);
    if (fs.existsSync(src)) {
      const dest = path.join(archiveDir, d + '_' + Date.now());
      fs.renameSync(src, dest);
      archived.push(dest);
    }
  }
}

for (const d of targets) {
  const p = path.join(baseDir, d);
  if (fs.existsSync(p)) {
    fs.rmSync(p, { recursive: true, force: true });
  }
  fs.mkdirSync(p, { recursive: true });
}

console.log(JSON.stringify({ success: true, data: { scope, targets, archived, baseDir, resetAt: new Date().toISOString() } }));
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        scope: { type: 'string', enum: ['full', 'profile', 'applications', 'interviews', 'outcomes', 'all_data'], description: 'Scope of data to reset' },
        confirm: { type: 'boolean', default: false, description: 'Require confirmation before resetting' },
        archive: { type: 'boolean', default: true, description: 'Archive data instead of permanent deletion' },
        profileId: { type: 'string', default: 'default', description: 'Profile ID to reset' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the reset succeeded' },
        data: { type: 'object', description: 'Reset details including scope, targets, and archived paths' },
      },
      required: ['success', 'data'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },
