  {
    id: 'career_expand',
    name: 'Expand Search',
    description:
      'Broaden the job search by discovering similar roles, alternative titles, adjacent companies, and adjacent industries. Generates new queries and target lists to feed back into the scrape tool.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const profilePath = path.join(baseDir, 'profiles', (input.profileId || 'default') + '.json');
const profile = fs.existsSync(profilePath) ? JSON.parse(fs.readFileSync(profilePath, 'utf8')) : {};
const prefs = profile.preferences || {};
const currentRoles = input.currentRoles || prefs.targetRoles || [];
const currentCompanies = input.currentCompanies || prefs.targetCompanies || [];
const currentKeywords = input.currentKeywords || prefs.keywords || [];
const industries = input.industries || prefs.industries || [];

const titleSynonyms = {
  'software engineer': ['software developer', 'sde', 'backend engineer', 'full stack engineer', 'platform engineer'],
  'data scientist': ['ml engineer', 'machine learning engineer', 'data analyst', 'ai researcher', 'analytics engineer'],
  'product manager': ['technical program manager', 'tpm', 'product owner', 'group product manager'],
  'devops engineer': ['sre', 'site reliability engineer', 'platform engineer', 'cloud engineer'],
  'frontend developer': ['ui engineer', 'ux engineer', 'front-end engineer', 'react developer'],
  'backend developer': ['api engineer', 'server engineer', 'microservices engineer'],
  'design engineer': ['product designer', 'ux designer', 'ui designer', 'interaction designer'],
};

function expandTitles(roles) {
  const expanded = new Set();
  for (const r of roles) {
    const key = r.toLowerCase();
    expanded.add(r);
    for (const [k, synonyms] of Object.entries(titleSynonyms)) {
      if (key.includes(k) || k.includes(key)) {
        for (const s of synonyms) expanded.add(s);
      }
    }
  }
  return Array.from(expanded);
}

function expandCompanies(companies, keywords) {
  const expanded = new Set(companies);
  // Add competitors based on keyword overlap heuristics
  const competitors = input.competitors || {};
  for (const c of companies) {
    for (const comp of (competitors[c] || [])) expanded.add(comp);
  }
  // Add adjacent companies from input
  for (const c of (input.adjacentCompanies || [])) expanded.add(c);
  return Array.from(expanded);
}

function expandKeywords(keywords, industries) {
  const expanded = new Set(keywords);
  const industryTerms = {
    fintech: ['blockchain', 'payments', 'trading', 'risk', 'compliance', 'aml'],
    saas: ['multi-tenant', 'subscription', 'billing', 'onboarding', 'retention'],
    ecommerce: ['catalog', 'inventory', 'checkout', 'logistics', 'recommendation'],
    healthcare: ['hipaa', 'ehr', 'fhir', 'clinical', 'telehealth'],
    ai: ['llm', 'vector', 'embedding', 'fine-tuning', 'rag', 'inference'],
    cybersecurity: ['threat', 'vulnerability', 'siem', 'zero trust', 'penetration'],
    devtools: ['ide', 'ci/cd', 'observability', 'developer experience'],
  };
  for (const ind of industries) {
    for (const t of (industryTerms[ind] || [])) expanded.add(t);
  }
  return Array.from(expanded);
}

const expanded = {
  titles: expandTitles(currentRoles),
  companies: expandCompanies(currentCompanies, currentKeywords),
  keywords: expandKeywords(currentKeywords, industries),
  industries,
  generatedAt: new Date().toISOString(),
};

const outPath = path.join(baseDir, 'applications', 'expansion.json');
fs.writeFileSync(outPath, JSON.stringify(expanded, null, 2));

console.log(JSON.stringify({ success: true, data: { expanded, outPath, newTitles: expanded.titles.length, newCompanies: expanded.companies.length } }));
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        profileId: { type: 'string', default: 'default', description: 'Identifier of the user profile to load (defaults to "default")' },
        currentRoles: { type: 'array', items: { type: 'string' }, description: 'Current job titles held by the user' },
        currentCompanies: { type: 'array', items: { type: 'string' }, description: 'Companies where the user currently works or has worked' },
        currentKeywords: { type: 'array', items: { type: 'string' }, description: 'Keywords describing the user\'s background and experience' },
        industries: { type: 'array', items: { type: 'string' }, description: 'Industries the user targets or operates in' },
        competitors: { type: 'object', description: 'Map of company -> competitor list' },
        adjacentCompanies: { type: 'array', items: { type: 'string' }, description: 'Companies adjacent to the user\'s current space for expansion' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the search expansion succeeded' },
        expanded: { type: 'object', description: 'Expanded search criteria (titles, companies, keywords)' },
        outPath: { type: 'string', description: 'File path where expansion was stored' },
        newTitles: { type: 'number', description: 'Number of new titles discovered' },
        newCompanies: { type: 'number', description: 'Number of new companies discovered' },
      },
      required: ['success', 'expanded', 'outPath', 'newTitles', 'newCompanies'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_upskill',
    name: 'Upskill Plan',
    description:
      'Generate a personalized upskilling plan based on gaps between the user profile and target roles. Recommends courses, certifications, projects, and practice milestones with timelines.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const profilePath = path.join(baseDir, 'profiles', (input.profileId || 'default') + '.json');
const profile = fs.existsSync(profilePath) ? JSON.parse(fs.readFileSync(profilePath, 'utf8')) : {};
const targetRole = input.targetRole || (profile.preferences && profile.preferences.targetRoles && profile.preferences.targetRoles[0]) || '';
const currentSkills = input.currentSkills || profile.skills || [];
const desiredSkills = input.desiredSkills || [];
const weeks = input.weeks || 12;

const skillResources = {
  'react': [{ name: 'React Official Docs + Tutorial', url: 'https://react.dev/learn/tutorial-tic-tac-toe', type: 'course' }, { name: 'Epic React by Kent C. Dodds', url: 'https://epicreact.dev/', type: 'course' }],
  'typescript': [{ name: 'TypeScript Handbook', url: 'https://www.typescriptlang.org/docs/handbook/intro.html', type: 'docs' }, { name: 'Total TypeScript', url: 'https://www.totaltypescript.com/', type: 'course' }],
  'node': [{ name: 'Node.js Official Docs', url: 'https://nodejs.org/en/docs', type: 'docs' }, { name: 'Node Best Practices', url: 'https://github.com/goldbergyoni/nodebestpractices', type: 'guide' }],
  'python': [{ name: 'Python Official Tutorial', url: 'https://docs.python.org/3/tutorial/', type: 'course' }, { name: 'Automate the Boring Stuff', url: 'https://automatetheboringstuff.com/', type: 'book' }],
  'aws': [{ name: 'AWS Cloud Practitioner Essentials', url: 'https://aws.amazon.com/training/learning-paths/cloud-practitioner/', type: 'cert' }, { name: 'A Cloud Guru', url: 'https://acloudguru.com/', type: 'course' }],
  'kubernetes': [{ name: 'Kubernetes Basics', url: 'https://kubernetes.io/docs/tutorials/kubernetes-basics/', type: 'course' }, { name: 'CKAD', url: 'https://training.linuxfoundation.org/certification/certified-kubernetes-application-developer-ckad/', type: 'cert' }],
  'docker': [{ name: 'Docker Get Started', url: 'https://docs.docker.com/get-started/', type: 'course' }],
  'system design': [{ name: 'Designing Data-Intensive Applications', url: 'https://dataintensive.net/', type: 'book' }, { name: 'System Design Primer', url: 'https://github.com/donnemartin/system-design-primer', type: 'guide' }],
  'machine learning': [{ name: 'ML Coursera by Andrew Ng', url: 'https://www.coursera.org/learn/machine-learning', type: 'course' }, { name: 'Fast.ai Practical Deep Learning', url: 'https://course.fast.ai/', type: 'course' }],
  'llm': [{ name: 'LangChain Tutorials', url: 'https://python.langchain.com/docs/get_started/tutorial', type: 'course' }, { name: 'Build LLM Apps', url: 'https://www.buildllmapps.com/', type: 'course' }],
};

const gaps = desiredSkills.filter((s) => !currentSkills.map((c) => c.toLowerCase()).includes(s.toLowerCase()));
const milestones = [];
let week = 1;
for (const skill of gaps) {
  const resources = skillResources[skill.toLowerCase()] || [{ name: skill + ' fundamentals', url: '', type: 'course' }];
  milestones.push({
    skill,
    week: week,
    durationWeeks: 2,
    resources,
    project: 'Build a small project demonstrating ' + skill,
    completed: false,
  });
  week += 2;
  if (week > weeks) break;
}

const plan = {
  targetRole,
  currentSkills,
  desiredSkills,
  gaps,
  milestones,
  totalWeeks: weeks,
  generatedAt: new Date().toISOString(),
};

const outPath = path.join(baseDir, 'outcomes', 'upskill_plan.json');
fs.mkdirSync(path.dirname(outPath), { recursive: true });
fs.writeFileSync(outPath, JSON.stringify(plan, null, 2));

console.log(JSON.stringify({ success: true, data: { plan, outPath, gapsCount: gaps.length, milestonesCount: milestones.length } }));
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        profileId: { type: 'string', default: 'default', description: 'Identifier of the user profile to load (defaults to "default")' },
        targetRole: { type: 'string', description: 'The role the user wants to transition into' },
        currentSkills: { type: 'array', items: { type: 'string' }, description: 'Skills the user currently possesses' },
        desiredSkills: { type: 'array', items: { type: 'string' }, description: 'Skills the user wants to acquire' },
        weeks: { type: 'number', default: 12, description: 'Total number of weeks for the upskilling plan' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the upskill plan was generated' },
        plan: { type: 'object', description: 'The upskilling plan with milestones' },
        outPath: { type: 'string', description: 'File path where plan was stored' },
        gapsCount: { type: 'number', description: 'Number of skill gaps identified' },
        milestonesCount: { type: 'number', description: 'Number of milestones in the plan' },
      },
      required: ['success', 'plan', 'outPath', 'gapsCount', 'milestonesCount'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_html_report',
    name: 'HTML Report',
    description:
      'Generate a standalone HTML career search report with sections for profile, applications, rankings, interviews, outcomes, and upskilling. Returns the file path and an inline HTML preview.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const profileId = input.profileId || 'default';
const reportType = input.reportType || 'summary'; // summary, weekly, monthly, full
const outDir = path.join(baseDir, 'reports');
fs.mkdirSync(outDir, { recursive: true });

function readJson(p, def) {
  try { return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf8')) : def; } catch { return def; }
}

const profile = readJson(path.join(baseDir, 'profiles', profileId + '.json'), {});
const listings = readJson(path.join(baseDir, 'applications', 'listings.json'), []);
const tracking = readJson(path.join(baseDir, 'applications', 'tracking.json'), []);
const rankings = readJson(path.join(baseDir, 'applications', 'rankings.json'), { ranked: [] });
const schedule = readJson(path.join(baseDir, 'interviews', 'schedule.json'), []);
const outcomes = readJson(path.join(baseDir, 'outcomes', 'log.json'), []);
const expansion = readJson(path.join(baseDir, 'applications', 'expansion.json'), null);
const upskill = readJson(path.join(baseDir, 'outcomes', 'upskill_plan.json'), null);

const stats = {
  applications: tracking.length,
  interviews: schedule.filter((s) => s.status === 'scheduled').length,
  offers: tracking.filter((t) => t.status === 'offer').length,
  rejections: tracking.filter((t) => t.status === 'rejection').length,
  topRanked: rankings.ranked ? rankings.ranked.slice(0, 5) : [],
};

function esc(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

const html = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Career Search Report - " + esc(profile.personal && profile.personal.name || profileId) + "</title>\n<style>\n  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; background: #0f172a; color: #e2e8f0; margin: 0; padding: 24px; }\n  h1 { color: #38bdf8; }\n  h2 { color: #94a3b8; border-bottom: 1px solid #334155; padding-bottom: 4px; }\n  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }\n  .card { background: #1e293b; border-radius: 8px; padding: 16px; }\n  .stat { font-size: 28px; font-weight: 700; color: #38bdf8; }\n  .label { color: #94a3b8; font-size: 12px; text-transform: uppercase; }\n  table { width: 100%; border-collapse: collapse; margin-top: 8px; }\n  th, td { text-align: left; padding: 8px; border-bottom: 1px solid #334155; }\n  th { color: #38bdf8; }\n  a { color: #38bdf8; }\n  .badge { background: #334155; padding: 2px 8px; border-radius: 12px; font-size: 12px; }\n</style>\n</head>\n<body>\n  <h1>Career Search Report</h1>\n  <p><span class=\"badge\">" + esc(reportType) + "</span> Generated " + new Date().toISOString().slice(0, 10) + " · Profile: " + esc(profileId) + "</p>\n\n  <h2>Overview</h2>\n  <div class=\"grid\">\n    <div class=\"card\"><div class=\"stat\">" + stats.applications + "</div><div class=\"label\">Applications</div></div>\n    <div class=\"card\"><div class=\"stat\">" + stats.interviews + "</div><div class=\"label\">Interviews Scheduled</div></div>\n    <div class=\"card\"><div class=\"stat\">" + stats.offers + "</div><div class=\"label\">Offers</div></div>\n    <div class=\"card\"><div class=\"stat\">" + stats.rejections + "</div><div class=\"label\">Rejections</div></div>\n  </div>\n\n  <h2>Top Ranked</h2>\n  <table>\n    <tr><th>Rank</th><th>Title</th><th>Company</th><th>Score</th></tr>\n    " + stats.topRanked.map((r, i) => '<tr><td>' + (i+1) + '</td><td>' + esc(r.title) + '</td><td>' + esc(r.company) + '</td><td>' + esc(r.score) + '</td></tr>').join('') + "\n  </table>\n\n  <h2>Applications</h2>\n  <table>\n    <tr><th>Company</th><th>Role</th><th>Status</th><th>Date</th></tr>\n    " + tracking.map((t) => '<tr><td>' + esc(t.company) + '</td><td>' + esc(t.role) + '</td><td>' + esc(t.status) + '</td><td>' + esc(t.date || t.appliedAt) + '</td></tr>').join('') + "\n  </table>\n\n  <h2>Interview Schedule</h2>\n  <table>\n    <tr><th>Company</th><th>Role</th><th>Type</th><th>Scheduled</th><th>Status</th></tr>\n    " + schedule.map((s) => '<tr><td>' + esc(s.company) + '</td><td>' + esc(s.role) + '</td><td>' + esc(s.interviewType) + '</td><td>' + esc(s.scheduledAt) + '</td><td>' + esc(s.status) + '</td></tr>').join('') + "\n  </table>\n\n  " + (expansion ? '<h2>Expanded Search</h2><pre>' + esc(JSON.stringify(expansion, null, 2)) + '</pre>' : '') + "\n  " + (upskill ? '<h2>Upskill Plan</h2><pre>' + esc(JSON.stringify(upskill, null, 2)) + '</pre>' : '') + "\n\n  <footer style=\"margin-top:32px;color:#475569;font-size:12px;\">Generated by Stage7 Career Coach</footer>\n</body>\n</html>";

const outPath = path.join(outDir, 'career_report_' + reportType + '_' + Date.now() + '.html');
fs.writeFileSync(outPath, html);

console.log(JSON.stringify({ success: true, data: { html, outPath, reportType, stats } }));
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        profileId: { type: 'string', default: 'default', description: 'Identifier of the user profile to load (defaults to "default")' },
        reportType: { type: 'string', enum: ['summary', 'weekly', 'monthly', 'full'], description: 'Type of report to generate: summary, weekly, monthly, or full' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the report was generated' },
        html: { type: 'string', description: 'The generated HTML report content' },
        outPath: { type: 'string', description: 'File path where report was stored' },
        stats: { type: 'object', description: 'Summary statistics included in the report' },
      },
      required: ['success', 'html', 'outPath', 'stats'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_notion_sync',
    name: 'Notion Sync',
    description:
      'Push career data (profile, applications, rankings, outcomes) to a Notion database or pages. Pulls existing schema and maps career entities to Notion properties. Requires a Notion integration token.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const token = process.env.NOTION_TOKEN || input.token || '';
const databaseId = input.databaseId || '';
const profileId = input.profileId || 'default';
const entityTypes = input.entityTypes || ['applications', 'rankings', 'outcomes'];
const direction = input.direction || 'push'; // push, pull, both
const dryRun = !!input.dryRun;

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
function readJson(p, def) {
  try { return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf8')) : def; } catch { return def; }
}

const data = {
  profile: readJson(path.join(baseDir, 'profiles', profileId + '.json'), {}),
  applications: readJson(path.join(baseDir, 'applications', 'tracking.json'), []),
  rankings: readJson(path.join(baseDir, 'applications', 'rankings.json'), { ranked: [] }),
  outcomes: readJson(path.join(baseDir, 'outcomes', 'log.json'), []),
};

const results = [];
(async () => {
  for (const type of entityTypes) {
    const payload = data[type];
    if (!payload) continue;
    if (dryRun) {
      results.push({ type, status: 'dry_run', records: Array.isArray(payload) ? payload.length : 1 });
      continue;
    }
    if (!token) {
      results.push({ type, status: 'skipped', reason: 'NOTION_TOKEN not configured' });
      continue;
    }
    try {
      const res = await fetch('https://api.notion.com/v1/pages', {
        method: 'POST',
        headers: {
          'Authorization': 'Bearer ' + token,
          'Notion-Version': '2022-06-28',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          parent: databaseId ? { database_id: databaseId } : undefined,
          properties: {
            career_type: { rich_text: [{ text: { content: type } }] },
            data: { rich_text: [{ text: { content: JSON.stringify(payload).slice(0, 1900) } }] },
            synced_at: { date: { start: new Date().toISOString() } },
          },
        }),
      });
      results.push({ type, status: res.ok ? 'synced' : 'failed', httpStatus: res.status, records: Array.isArray(payload) ? payload.length : 1 });
    } catch (err) {
      results.push({ type, status: 'error', error: err instanceof Error ? err.message : String(err) });
    }
  }
  console.log(JSON.stringify({ success: results.every((r) => r.status !== 'failed' && r.status !== 'error'), data: { direction, results, dryRun } }));
})();
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        token: { type: 'string', description: 'Notion integration token (overrides NOTION_TOKEN env)' },
        databaseId: { type: 'string', description: 'Notion database ID to sync to' },
        profileId: { type: 'string', default: 'default', description: 'Profile ID for multi-profile support' },
        entityTypes: { type: 'array', items: { type: 'string' }, description: 'Entity types to sync (applications, rankings, outcomes)' },
        direction: { type: 'string', enum: ['push', 'pull', 'both'], description: 'Sync direction' },
        dryRun: { type: 'boolean', default: false, description: 'Simulate without making changes' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the Notion sync succeeded' },
        data: { type: 'object', description: 'Sync results with direction and per-entity results' },
      },
      required: ['success', 'data'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_gmail_sync',
    name: 'Gmail Sync',
    description:
      'Search Gmail for job-related emails (rejections, interview invites, recruiter outreach, application confirmations) and log them into the career outcomes tracker. Requires Gmail OAuth credentials.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
(async () => {
  const input = __tool_input || {};
  const fs = require('fs');
  const path = require('path');

  const accessToken = process.env.GMAIL_ACCESS_TOKEN || input.accessToken || '';
  const refreshToken = process.env.GMAIL_REFRESH_TOKEN || input.refreshToken || '';
  const clientId = process.env.GMAIL_CLIENT_ID || input.clientId || '';
  const clientSecret = process.env.GMAIL_CLIENT_SECRET || input.clientSecret || '';
  const query = input.query || 'job OR interview OR recruiter OR application OR rejection OR offer';
  const maxResults = input.maxResults || 25;
  const markRead = !!input.markRead;
  const dryRun = !!input.dryRun;

  const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
  const outcomesPath = path.join(baseDir, 'outcomes', 'log.json');
  const outcomes = fs.existsSync(outcomesPath) ? JSON.parse(fs.readFileSync(outcomesPath, 'utf8')) : [];

  function classifyEmail(subject, body) {
    const text = (subject + ' ' + (body || '')).toLowerCase();
    if (/offer|congratulations|excited to offer|extended an offer/.test(text)) return 'offer';
    if (/rejection|unfortunately|not moving forward|not selected/.test(text)) return 'rejection';
    if (/interview|schedule|invite|meet/.test(text)) return 'interview';
    if (/screening/.test(text)) return 'screening';
    if (/application|submitted|received your application/.test(text)) return 'application_confirmation';
    return 'unclassified';
  }

  let messages = [];
  if (!accessToken && !dryRun) {
    console.log(JSON.stringify({ success: false, error: 'GMAIL_ACCESS_TOKEN not configured', data: { results: [] } }));
  } else if (dryRun || !accessToken) {
    messages = [
      { id: 'demo_1', subject: 'Interview Invitation - Software Engineer', body: 'We would like to schedule a phone screen.', internalDate: Date.now() - 86400000 },
      { id: 'demo_2', subject: 'Application Received', body: 'Thanks for applying to Acme Corp.', internalDate: Date.now() - 2 * 86400000 },
    ];
  } else {
    try {
      const listRes = await fetch('https://gmail.googleapis.com/gmail/v1/users/me/messages?q=' + encodeURIComponent(query) + '&maxResults=' + maxResults, {
        headers: { Authorization: 'Bearer ' + accessToken },
      });
      const listData = await listRes.json();
      messages = (listData.messages || []).map((m) => ({ id: m.id }));
      for (const m of messages) {
        const detailRes = await fetch('https://gmail.googleapis.com/gmail/v1/users/me/messages/' + m.id, {
          headers: { Authorization: 'Bearer ' + accessToken },
        });
        const detail = await detailRes.json();
        const subject = (detail.payload && detail.payload.headers ? detail.payload.headers.find((h) => h.name === 'Subject') : {}) || {};
        const snippet = detail.snippet || '';
        m.subject = subject.value || '';
        m.snippet = snippet;
        m.internalDate = detail.internalDate ? parseInt(detail.internalDate) : Date.now();
      }
    } catch (err) {
      console.log(JSON.stringify({ success: false, error: err instanceof Error ? err.message : String(err), data: { results: [] } }));
    }
  }

  const results = [];
  for (const m of messages) {
    const type = classifyEmail(m.subject, m.snippet);
    const entry = {
      jobId: 'gmail_' + m.id,
      company: '',
      role: '',
      status: type === 'offer' ? 'offer' : type === 'rejection' ? 'rejection' : type === 'interview' ? 'interview' : type === 'screening' ? 'screening' : 'no_response',
      source: 'gmail',
      emailSubject: m.subject,
      date: m.internalDate ? new Date(parseInt(m.internalDate)).toISOString() : new Date().toISOString(),
      notes: m.snippet,
      updatedAt: new Date().toISOString(),
    };
    if (!dryRun && accessToken) {
      outcomes.push(entry);
    }
    results.push(entry);
  }

  if (!dryRun && accessToken) {
    fs.writeFileSync(outcomesPath, JSON.stringify(outcomes, null, 2));
  }

  console.log(JSON.stringify({ success: true, data: { results, outcomesPath, dryRun, total: results.length } }));
})();
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        accessToken: { type: 'string', description: 'Gmail OAuth access token' },
        refreshToken: { type: 'string', description: 'Gmail OAuth refresh token' },
        clientId: { type: 'string', description: 'Gmail OAuth client ID' },
        clientSecret: { type: 'string', description: 'Gmail OAuth client secret' },
        query: { type: 'string', description: 'Gmail search query for job-related emails' },
        maxResults: { type: 'number', default: 25, description: 'Maximum number of emails to fetch' },
        markRead: { type: 'boolean', default: false, description: 'Mark processed emails as read' },
        dryRun: { type: 'boolean', default: false, description: 'Simulate without making changes' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the Gmail sync succeeded' },
        data: { type: 'object', description: 'Sync results with parsed emails and outcomes' },
      },
      required: ['success', 'data'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_add_template',
    name: 'Add Template',
    description:
      'Register a new resume or cover letter template in the career workspace. Templates are named, versioned, and can be reused across applications with variable substitution.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const kind = input.kind || 'cover_letter'; // resume, cover_letter
const name = input.name || 'template_' + Date.now();
const content = input.content || '';
const variables = input.variables || [];
const description = input.description || '';
const profileId = input.profileId || 'default';

if (!content) {
  console.log(JSON.stringify({ success: false, error: 'Template content is required' }));
  process.exit(0);
}

const dir = path.join(baseDir, kind === 'resume' ? 'resumes' : 'cover_letters');
fs.mkdirSync(dir, { recursive: true });
const outPath = path.join(dir, name + '.json');
const template = {
  id: name,
  kind,
  name,
  content,
  variables,
  description,
  profileId,
  createdAt: new Date().toISOString(),
  updatedAt: new Date().toISOString(),
  version: 1,
};
fs.writeFileSync(outPath, JSON.stringify(template, null, 2));

console.log(JSON.stringify({ success: true, data: { template, outPath } }));
`,
    },
