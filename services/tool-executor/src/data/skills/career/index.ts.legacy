import { Tool } from '../../../types';
import { createExternalActionSkill } from '../code-skill-factory';

const CAREER_EXTERNAL_OUTPUT_SCHEMA: Record<string, unknown> = {
  type: 'object',
  properties: {
    success: { type: 'boolean' },
    mode: { type: 'string', enum: ['dry-run', 'live', 'error'] },
    system: { type: 'string' },
    action: { type: 'string' },
    request: {
      type: ['object', 'null'],
      properties: {
        input: { type: 'object' },
        endpoint: { type: 'string' },
        method: { type: 'string' },
        headers: { type: 'object' },
      },
    },
    response: {
      type: ['object', 'null'],
      properties: {
        status: { type: 'number' },
        data: { type: ['object', 'string', 'null'] },
      },
    },
    error: { type: ['string', 'null'] },
  },
  required: ['success', 'mode', 'system', 'action', 'request', 'response', 'error'],
};

/**
 * Career Coach / AI Job Search tool suite.
 *
 * Each tool is a `code`-type tool. The `manifest.sourceCode` is a JavaScript
 * string that the ToolExecutor runs inside a sandboxed node process. The
 * sandbox injects `__tool_input` (the user-supplied input object) as a global
 * before executing the script. Tools should `console.log(JSON.stringify(result))`
 * to return structured output.
 *
 * All tools share a common runtime contract:
 *   input:  { ...fields }
 *   output: { success: boolean, data?: any, error?: string, meta?: object }
 */

const CAREER_TOOLS: Tool[] = [
  {
    id: 'career_setup',
    name: 'Career Setup',
    description:
      'Initialize the career coach workspace: profile, preferences, target roles, and storage layout. Creates the user record used by all other career tools.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const dirs = ['profiles', 'resumes', 'applications', 'cover_letters', 'interviews', 'outcomes', 'reports'];
for (const d of dirs) {
  fs.mkdirSync(path.join(baseDir, d), { recursive: true });
}

const profile = {
  id: input.profileId || 'default',
  personal: {
    name: input.name || '',
    email: input.email || '',
    phone: input.phone || '',
    location: input.location || '',
    linkedinUrl: input.linkedinUrl || '',
    githubUrl: input.githubUrl || '',
    portfolioUrl: input.portfolioUrl || '',
  },
  preferences: {
    targetRoles: input.targetRoles || [],
    targetCompanies: input.targetCompanies || [],
    industries: input.industries || [],
    workArrangement: input.workArrangement || ['onsite', 'hybrid', 'remote'],
    minSalary: input.minSalary || 0,
    maxSalary: input.maxSalary || 0,
    locations: input.locations || [],
    excludeCompanies: input.excludeCompanies || [],
    keywords: input.keywords || [],
  },
  jobSearch: {
    status: 'active',
    startDate: new Date().toISOString(),
    applicationsSubmitted: 0,
    interviewsScheduled: 0,
    offersReceived: 0,
    rejectionsReceived: 0,
  },
  createdAt: new Date().toISOString(),
  updatedAt: new Date().toISOString(),
};

const profilePath = path.join(baseDir, 'profiles', profile.id + '.json');
fs.writeFileSync(profilePath, JSON.stringify(profile, null, 2));

console.log(JSON.stringify({
  success: true,
  data: {
    profileId: profile.id,
    profilePath,
    workspace: baseDir,
    directoriesCreated: dirs,
    profile,
  },
}));
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        profileId: { type: 'string', description: 'Unique identifier for this profile (default: "default")' },
        name: { type: 'string', description: 'Full name' },
        email: { type: 'string', description: 'Primary email address' },
        phone: { type: 'string', description: 'Phone number' },
        location: { type: 'string', description: 'Current city/region' },
        linkedinUrl: { type: 'string', description: 'LinkedIn profile URL' },
        githubUrl: { type: 'string', description: 'GitHub profile URL' },
        portfolioUrl: { type: 'string', description: 'Portfolio website URL' },
        targetRoles: { type: 'array', items: { type: 'string' }, description: 'Job titles to pursue' },
        targetCompanies: { type: 'array', items: { type: 'string' }, description: 'Companies of interest' },
        industries: { type: 'array', items: { type: 'string' }, description: 'Industries of interest' },
        workArrangement: { type: 'array', items: { type: 'string' }, enum: ['onsite', 'hybrid', 'remote'], description: 'Preferred work arrangements' },
        minSalary: { type: 'number', description: 'Minimum acceptable salary' },
        maxSalary: { type: 'number', description: 'Maximum acceptable salary' },
        locations: { type: 'array', items: { type: 'string' }, description: 'Preferred job locations' },
        excludeCompanies: { type: 'array', items: { type: 'string' }, description: 'Companies to exclude from search' },
        keywords: { type: 'array', items: { type: 'string' }, description: 'Keywords to match in job descriptions' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the setup succeeded' },
        profileId: { type: 'string', description: 'Unique identifier for the created profile' },
        profilePath: { type: 'string', description: 'File path where the profile was stored' },
        workspace: { type: 'string', description: 'Base workspace directory path' },
        directoriesCreated: { type: 'array', description: 'List of created directory names' },
        profile: { type: 'object', description: 'The created profile object' },
      },
      required: ['success', 'profileId', 'profilePath', 'workspace', 'directoriesCreated', 'profile'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_scrape',
    name: 'Scrape Job Listings',
    description:
      'Scrape job listings from configured job portals (Indeed, LinkedIn, ZipRecruiter, company career pages). Returns normalized job objects with title, company, location, salary, description, and apply URL.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const queries = input.queries || input.query ? [input.query] : [];
const sources = input.sources || ['indeed', 'linkedin', 'ziprecruiter'];
const maxResults = input.maxResults || 50;
const location = input.location || '';
const remoteOnly = input.remoteOnly || false;

function normalizeJob(raw, source) {
  return {
    id: raw.id || 'job_' + Math.random().toString(36).slice(2, 10),
    title: raw.title || '',
    company: raw.company || '',
    location: raw.location || '',
    remote: /remote/i.test((raw.location || '') + ' ' + (raw.description || '')),
    salary: raw.salary || null,
    description: (raw.description || '').slice(0, 2000),
    applyUrl: raw.applyUrl || raw.url || '',
    postedDate: raw.postedDate || null,
    source,
    scrapedAt: new Date().toISOString(),
  };
}

const results = [];
for (const source of sources) {
  for (const q of queries) {
    // In production this would call the portal API/HTML parser.
    // Here we synthesize deterministic placeholder listings so the tool is
    // usable offline; real portal scraping is configured via portal config.
    const count = Math.min(maxResults - results.length, 10);
    for (let i = 0; i < count; i++) {
      results.push(normalizeJob({
        id: source + '_' + q.replace(/\s+/g, '_') + '_' + i,
        title: q,
        company: (input.targetCompanies && input.targetCompanies[i % input.targetCompanies.length]) || 'Company ' + i,
        location: location || 'Remote',
        salary: { min: input.minSalary || 80000, max: input.maxSalary || 140000, currency: 'USD' },
        description: 'Placeholder listing for query "' + q + '" on ' + source,
        applyUrl: 'https://' + source + '.com/job/' + i,
        postedDate: new Date(Date.now() - i * 86400000).toISOString(),
      }, source));
    }
    if (results.length >= maxResults) break;
  }
  if (results.length >= maxResults) break;
}

const outDir = path.join(baseDir, 'applications');
fs.mkdirSync(outDir, { recursive: true });
const listPath = path.join(outDir, 'listings.json');
const existing = fs.existsSync(listPath) ? JSON.parse(fs.readFileSync(listPath, 'utf8')) : [];
const merged = [...existing];
for (const r of results) {
  const idx = merged.findIndex((m) => m.id === r.id);
  if (idx >= 0) merged[idx] = r;
  else merged.push(r);
}
fs.writeFileSync(listPath, JSON.stringify(merged, null, 2));

console.log(JSON.stringify({
  success: true,
  data: {
    listings: results,
    total: results.length,
    storagePath: listPath,
    sources,
    queries,
  },
}));
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        query: { type: 'string', description: 'Single search query' },
        queries: { type: 'array', items: { type: 'string' }, description: 'Multiple search queries' },
        sources: { type: 'array', items: { type: 'string' }, description: 'Portal keys to scrape' },
        location: { type: 'string', description: 'Job location filter' },
        remoteOnly: { type: 'boolean', description: 'Filter for remote-only positions' },
        maxResults: { type: 'number', default: 50, description: 'Maximum results per source' },
        targetCompanies: { type: 'array', items: { type: 'string' }, description: 'Specific companies to target' },
        minSalary: { type: 'number', description: 'Minimum salary filter' },
        maxSalary: { type: 'number', description: 'Maximum salary filter' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the job scraping succeeded' },
        listings: { type: 'array', description: 'Array of scraped job listings' },
        total: { type: 'number', description: 'Total number of listings scraped' },
        storagePath: { type: 'string', description: 'File path where listings were stored' },
      },
      required: ['success', 'listings', 'total', 'storagePath'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_apply',
    name: 'Apply to Jobs',
    description:
      'Submit applications to one or more jobs using the stored resume and a generated or selected cover letter. When a portal submit config is registered via career_add_portal, submits to the real endpoint; otherwise simulates. Supports bulk apply, dry-run, and tracking of submitted vs failed applications.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const jobIds = input.jobIds || (input.jobId ? [input.jobId] : []);
const resumeId = input.resumeId || 'default';
const coverLetterId = input.coverLetterId || null;
const bulk = !!input.bulk;
const dryRun = !!input.dryRun;

const listingsPath = path.join(baseDir, 'applications', 'listings.json');
const listings = fs.existsSync(listingsPath) ? JSON.parse(fs.readFileSync(listingsPath, 'utf8')) : [];
const resumePath = path.join(baseDir, 'resumes', resumeId + '.json');
const resume = fs.existsSync(resumePath) ? JSON.parse(fs.readFileSync(resumePath, 'utf8')) : null;

const applications = [];
const errors = [];

(async () => {
  for (const id of jobIds) {
    const job = listings.find((l) => l.id === id);
    if (!job) {
      errors.push({ jobId: id, error: 'Job listing not found' });
      continue;
    }

    if (dryRun) {
      applications.push({ jobId: id, status: 'dry_run', job: { title: job.title, company: job.company }, appliedAt: new Date().toISOString() });
      continue;
    }

    // Resolve portal submit config for this job's source
    const portalsPath = path.join(baseDir, 'applications', 'portals.json');
    const portals = fs.existsSync(portalsPath) ? JSON.parse(fs.readFileSync(portalsPath, 'utf8')) : [];
    const portal = portals.find((p) => p.id === job.source && p.enabled && p.submitUrlTemplate);

    if (portal) {
      // Real submission via portal submit endpoint
      let submitUrl = portal.submitUrlTemplate
        .replace(/\{jobId\}/g, encodeURIComponent(id))
        .replace(/\{applyUrl\}/g, encodeURIComponent(job.applyUrl || ''));
      if (!submitUrl.startsWith('http')) {
        submitUrl = (portal.baseUrl || 'https://').replace(/\/$/, '') + submitUrl;
      }

      // Resolve portal auth into request headers via the shared sandbox
      // resolver (__resolveAuth). This is a feature of ALL assistants, not
      // only the career coach — any code-type tool can call it.
      const { headers: authHeaders } = await __resolveAuth(portal.auth || {});

      const headers = Object.assign({
        'Content-Type': 'application/json',
      }, portal.submitHeaders || {}, authHeaders);

      let body = null;
      if (portal.submitBodyTemplate) {
        const safeResume = resume ? JSON.stringify(resume).slice(0, 1900) : '';
        const safeCover = coverLetterId ? JSON.stringify(coverLetterId).slice(0, 200) : '';
        const safeJob = JSON.stringify({ title: job.title, company: job.company, location: job.location }).slice(0, 800);
        body = portal.submitBodyTemplate
          .replace(/\{resume\}/g, safeResume)
          .replace(/\{coverLetter\}/g, safeCover)
          .replace(/\{job\}/g, safeJob);
      }

      try {
        const res = await fetch(submitUrl, {
          method: portal.submitMethod || 'POST',
          headers,
          body,
        });
        const text = await res.text();
        let parsed = null;
        try { parsed = JSON.parse(text); } catch { parsed = { raw: text.slice(0, 500) }; }
        if (res.ok) {
          applications.push({
            jobId: id,
            status: 'submitted',
            job: { title: job.title, company: job.company, location: job.location },
            resumeUsed: resumeId,
            coverLetterUsed: coverLetterId,
            applyUrl: job.applyUrl,
            portalId: portal.id,
            submitUrl,
            httpStatus: res.status,
            response: parsed,
            appliedAt: new Date().toISOString(),
          });
        } else {
          errors.push({ jobId: id, error: 'Portal rejected submission', httpStatus: res.status, response: parsed, portalId: portal.id });
        }
      } catch (err) {
        errors.push({ jobId: id, error: 'Submission request failed: ' + (err instanceof Error ? err.message : String(err)), portalId: portal.id });
      }
      continue;
    }

    // Fallback: simulate the submit when no portal submit config is registered
    const ok = !job.applyUrl || job.applyUrl.startsWith('http');
    if (!ok) {
      errors.push({ jobId: id, error: 'Invalid apply URL', applyUrl: job.applyUrl });
      continue;
    }

    applications.push({
      jobId: id,
      status: 'submitted',
      job: { title: job.title, company: job.company, location: job.location },
      resumeUsed: resumeId,
      coverLetterUsed: coverLetterId,
      applyUrl: job.applyUrl,
      appliedAt: new Date().toISOString(),
    });
  }

  const trackingPath = path.join(baseDir, 'applications', 'tracking.json');
  fs.mkdirSync(path.dirname(trackingPath), { recursive: true });
  const tracking = fs.existsSync(trackingPath) ? JSON.parse(fs.readFileSync(trackingPath, 'utf8')) : [];
  for (const app of applications) {
    const idx = tracking.findIndex((t) => t.jobId === app.jobId);
    if (idx >= 0) tracking[idx] = app;
    else tracking.push(app);
  }
  fs.writeFileSync(trackingPath, JSON.stringify(tracking, null, 2));

  console.log(JSON.stringify({
    success: errors.length === 0,
    data: {
      applications,
      errors,
      submitted: applications.filter((a) => a.status === 'submitted').length,
      dryRun,
      bulk,
      trackingPath,
    },
  }));
})();
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        jobId: { type: 'string', description: 'Single job ID to apply to' },
        jobIds: { type: 'array', items: { type: 'string' }, description: 'Bulk apply to multiple jobs' },
        resumeId: { type: 'string', default: 'default', description: 'ID of the resume to use for applications' },
        coverLetterId: { type: 'string', description: 'ID of the cover letter template to use' },
        bulk: { type: 'boolean', default: false, description: 'When true, process all jobIds as a batch' },
        dryRun: { type: 'boolean', default: false, description: 'Simulate without submitting' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether all applications succeeded' },
        applications: { type: 'array', description: 'Array of application results' },
        errors: { type: 'array', description: 'Array of application errors' },
        submitted: { type: 'number', description: 'Number of successfully submitted applications' },
        trackingPath: { type: 'string', description: 'File path where application tracking was stored' },
      },
      required: ['success', 'applications', 'errors', 'submitted', 'trackingPath'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_rank',
    name: 'Rank Opportunities',
    description:
      'Score and rank job listings against the user profile using weighted criteria: role match, company preference, salary fit, location/remote, and keyword overlap. Returns a sorted ranking with rationale.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const jobIds = input.jobIds || null;
const listingsPath = path.join(baseDir, 'applications', 'listings.json');
const listings = fs.existsSync(listingsPath) ? JSON.parse(fs.readFileSync(listingsPath, 'utf8')) : [];
const profilePath = path.join(baseDir, 'profiles', (input.profileId || 'default') + '.json');
const profile = fs.existsSync(profilePath) ? JSON.parse(fs.readFileSync(profilePath, 'utf8')) : {};

const prefs = profile.preferences || {};
const targetRoles = (prefs.targetRoles || []).map((r) => r.toLowerCase());
const targetCompanies = (prefs.targetCompanies || []).map((c) => c.toLowerCase());
const keywords = (prefs.keywords || []).map((k) => k.toLowerCase());
const minSalary = prefs.minSalary || 0;
const maxSalary = prefs.maxSalary || Infinity;
const excludeCompanies = (prefs.excludeCompanies || []).map((c) => c.toLowerCase());

const weights = input.weights || {
  role: 0.35,
  company: 0.15,
  salary: 0.2,
  location: 0.15,
  keywords: 0.15,
};

function scoreJob(job) {
  let score = 0;
  const rationale = [];

  // Role match
  const title = (job.title || '').toLowerCase();
  const roleScore = targetRoles.length ? targetRoles.some((r) => title.includes(r) || title.startsWith(r)) ? 1 : 0 : 0.5;
  score += roleScore * weights.role;
  if (roleScore > 0) rationale.push('Title matches target role');

  // Company match
  const company = (job.company || '').toLowerCase();
  const excluded = excludeCompanies.some((c) => company.includes(c));
  const companyScore = excluded ? 0 : (targetCompanies.length ? (targetCompanies.some((c) => company.includes(c)) ? 1 : 0.3) : 0.5);
  score += companyScore * weights.company;
  if (excluded) rationale.push('Company is excluded');
  else if (companyScore > 0.5) rationale.push('Target company match');

  // Salary fit
  const sal = job.salary || {};
  let salaryScore = 0.5;
  if (sal.min && sal.max) {
    const overlap = Math.max(0, Math.min(sal.max, maxSalary) - Math.max(sal.min, minSalary));
    const range = Math.max(1, (maxSalary || sal.max) - (minSalary || sal.min));
    salaryScore = Math.min(1, overlap / range);
  }
  score += salaryScore * weights.salary;
  if (salaryScore > 0.7) rationale.push('Salary fits target range');

  // Location / remote
  const remote = !!job.remote;
  const workArrangement = prefs.workArrangement || ['onsite', 'hybrid', 'remote'];
  const locationScore = remote || workArrangement.includes('remote') ? 1 : 0.5;
  score += locationScore * weights.location;
  if (remote) rationale.push('Remote friendly');

  // Keyword overlap
  const desc = (job.description || '').toLowerCase();
  const kwScore = keywords.length ? keywords.filter((k) => desc.includes(k)).length / keywords.length : 0.5;
  score += kwScore * weights.keywords;
  if (kwScore > 0.5) rationale.push('Strong keyword overlap');

  return {
    jobId: job.id,
    title: job.title,
    company: job.company,
    score: Math.round(score * 100) / 100,
    weightedBreakdown: {
      role: Math.round(roleScore * weights.role * 100) / 100,
      company: Math.round(companyScore * weights.company * 100) / 100,
      salary: Math.round(salaryScore * weights.salary * 100) / 100,
      location: Math.round(locationScore * weights.location * 100) / 100,
      keywords: Math.round(kwScore * weights.keywords * 100) / 100,
    },
    rationale,
    excluded,
  };
}

let candidates = listings;
if (jobIds && jobIds.length) {
  candidates = listings.filter((l) => jobIds.includes(l.id));
}
const ranked = candidates
  .map(scoreJob)
  .filter((r) => !r.excluded)
  .sort((a, b) => b.score - a.score);

const rankPath = path.join(baseDir, 'applications', 'rankings.json');
fs.writeFileSync(rankPath, JSON.stringify({ ranked, generatedAt: new Date().toISOString(), weights }, null, 2));

console.log(JSON.stringify({
  success: true,
  data: {
    ranked,
    totalScored: candidates.length,
    totalAfterFilter: ranked.length,
    rankPath,
    weights,
  },
}));
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        profileId: { type: 'string', default: 'default', description: 'ID of the user profile to score jobs against' },
        jobIds: { type: 'array', items: { type: 'string' }, description: 'Specific job IDs to rank; if omitted, all listings are considered' },
        weights: { type: 'object', description: 'Custom weight overrides' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the ranking succeeded' },
        ranked: { type: 'array', description: 'Array of ranked job listings with scores' },
        totalScored: { type: 'number', description: 'Total number of jobs scored' },
        rankPath: { type: 'string', description: 'File path where rankings were stored' },
      },
      required: ['success', 'ranked', 'totalScored', 'rankPath'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_interview',
    name: 'Interview Prep',
    description:
      'Generate interview preparation materials: company research, likely questions, STAR response outlines, and a practice session tracker. Also logs interview outcomes and follow-ups.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const action = input.action || 'prepare';
const jobId = input.jobId || '';
const company = input.company || '';
const role = input.role || '';
const interviewType = input.interviewType || 'phone'; // phone, video, onsite, panel, technical
const scheduledAt = input.scheduledAt || null;
const notes = input.notes || '';

const listingsPath = path.join(baseDir, 'applications', 'listings.json');
const listings = fs.existsSync(listingsPath) ? JSON.parse(fs.readFileSync(listingsPath, 'utf8')) : [];
const job = listings.find((l) => l.id === jobId) || { title: role, company, description: '' };

const prep = {
  jobId,
  company: job.company || company,
  role: job.title || role,
  interviewType,
  scheduledAt,
  research: {
    companyOverview: input.companyOverview || 'Research the company mission, values, recent news, and products.',
    recentNews: input.recentNews || [],
    competitors: input.competitors || [],
    glassdoorInsights: input.glassdoorInsights || null,
  },
  likelyQuestions: input.likelyQuestions || [
    'Tell me about yourself.',
    'Why do you want to work at ' + (job.company || company) + '?',
    'Describe a challenging project and your role in it.',
    'How do you handle tight deadlines or conflicting priorities?',
    'What are your greatest strengths and weaknesses?',
  ],
  starOutlines: input.starOutlines || [],
  questionsToAsk: input.questionsToAsk || [
    'What does success look like in this role in the first 90 days?',
    'How does the team collaborate and make decisions?',
    'What are the biggest challenges the team is facing today?',
  ],
  practiceLog: input.practiceLog || [],
  notes,
  createdAt: new Date().toISOString(),
};

if (action === 'schedule') {
  const schedulePath = path.join(baseDir, 'interviews', 'schedule.json');
  fs.mkdirSync(path.dirname(schedulePath), { recursive: true });
  const schedule = fs.existsSync(schedulePath) ? JSON.parse(fs.readFileSync(schedulePath, 'utf8')) : [];
  const entry = { ...prep, status: 'scheduled', scheduledAt };
  const idx = schedule.findIndex((s) => s.jobId === jobId);
  if (idx >= 0) schedule[idx] = entry;
  else schedule.push(entry);
  fs.writeFileSync(schedulePath, JSON.stringify(schedule, null, 2));
  console.log(JSON.stringify({ success: true, data: { entry, schedulePath } }));
  process.exit(0);
}

if (action === 'complete') {
  const schedulePath = path.join(baseDir, 'interviews', 'schedule.json');
  fs.mkdirSync(path.dirname(schedulePath), { recursive: true });
  const schedule = fs.existsSync(schedulePath) ? JSON.parse(fs.readFileSync(schedulePath, 'utf8')) : [];
  const entry = { ...prep, status: 'completed', outcome: input.outcome, feedback: input.feedback, completedAt: new Date().toISOString() };
  const idx = schedule.findIndex((s) => s.jobId === jobId);
  if (idx >= 0) schedule[idx] = entry;
  else schedule.push(entry);
  fs.writeFileSync(schedulePath, JSON.stringify(schedule, null, 2));
  console.log(JSON.stringify({ success: true, data: { entry, schedulePath } }));
  process.exit(0);
}

const prepPath = path.join(baseDir, 'interviews', (jobId || 'general') + '_prep.json');
fs.mkdirSync(path.dirname(prepPath), { recursive: true });
fs.writeFileSync(prepPath, JSON.stringify(prep, null, 2));
console.log(JSON.stringify({ success: true, data: { prep, prepPath } }));
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        action: { type: 'string', enum: ['prepare', 'schedule', 'complete'], description: 'Operation to perform: prepare interview materials, schedule an interview, or complete an interview.' },
        jobId: { type: 'string', description: 'Identifier of the job associated with the interview.' },
        company: { type: 'string', description: 'Company hosting the interview.' },
        role: { type: 'string', description: 'Job title or role for the interview.' },
        interviewType: { type: 'string', description: 'Interview format, such as phone, video, onsite, panel, or technical.' },
        scheduledAt: { type: 'string', description: 'Scheduled interview date and time in ISO 8601 format.' },
        notes: { type: 'string', description: 'Additional notes or context for the interview.' },
        outcome: { type: 'string', description: 'Result of the completed interview.' },
        feedback: { type: 'string', description: 'Feedback received after the interview.' },
        likelyQuestions: { type: 'array', description: 'Likely questions to prepare for the interview.' },
        starOutlines: { type: 'array', description: 'STAR (Situation, Task, Action, Result) outlines for interview answers.' },
        questionsToAsk: { type: 'array', description: 'Questions for the candidate to ask the interviewer.' },
        companyOverview: { type: 'string', description: 'Overview of the company, including its mission, products, and culture.' },
        recentNews: { type: 'array', description: 'Recent news or developments about the company.' },
        competitors: { type: 'array', description: 'Companies competing with the target company.' },
        practiceLog: { type: 'array', description: 'Log of interview practice sessions and performance.' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the interview prep succeeded' },
        prep: { type: 'object', description: 'Interview preparation materials' },
        entry: { type: 'object', description: 'Scheduled or completed interview entry' },
        prepPath: { type: 'string', description: 'File path where prep materials were stored' },
      },
      required: ['success', 'prep', 'entry', 'prepPath'],
    },
    createdAt: new Date(),
    updatedAt: new Date(),
  },

  {
    id: 'career_outcome',
    name: 'Track Outcomes',
    description:
      'Record application outcomes (offer, rejection, interview, screening, no-response) and update career search stats. Also supports outcome analytics and trend reporting.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const jobId = input.jobId || '';
const status = input.status || ''; // offer, rejection, interview, screening, no_response, withdrawn
const company = input.company || '';
const role = input.role || '';
const salaryOffered = input.salaryOffered || null;
const notes = input.notes || '';
const date = input.date || new Date().toISOString();

const trackingPath = path.join(baseDir, 'applications', 'tracking.json');
fs.mkdirSync(path.dirname(trackingPath), { recursive: true });
const tracking = fs.existsSync(trackingPath) ? JSON.parse(fs.readFileSync(trackingPath, 'utf8')) : [];

const entry = {
  jobId,
  company,
  role,
  status,
  salaryOffered,
  notes,
  date,
  updatedAt: new Date().toISOString(),
};

const idx = tracking.findIndex((t) => t.jobId === jobId);
if (idx >= 0) tracking[idx] = Object.assign(tracking[idx], entry);
else tracking.push(entry);
fs.writeFileSync(trackingPath, JSON.stringify(tracking, null, 2));

// Update profile stats
const profilePath = path.join(baseDir, 'profiles', (input.profileId || 'default') + '.json');
if (fs.existsSync(profilePath)) {
  const profile = JSON.parse(fs.readFileSync(profilePath, 'utf8'));
  profile.jobSearch = profile.jobSearch || {};
  if (status === 'offer') profile.jobSearch.offersReceived = (profile.jobSearch.offersReceived || 0) + 1;
  if (status === 'rejection') profile.jobSearch.rejectionsReceived = (profile.jobSearch.rejectionsReceived || 0) + 1;
  if (status === 'interview' || status === 'screening') profile.jobSearch.interviewsScheduled = (profile.jobSearch.interviewsScheduled || 0) + 1;
  profile.jobSearch.updatedAt = new Date().toISOString();
  fs.writeFileSync(profilePath, JSON.stringify(profile, null, 2));
}

// Outcome log
const outcomesPath = path.join(baseDir, 'outcomes', 'log.json');
fs.mkdirSync(path.dirname(outcomesPath), { recursive: true });
const outcomes = fs.existsSync(outcomesPath) ? JSON.parse(fs.readFileSync(outcomesPath, 'utf8')) : [];
outcomes.push(entry);
fs.writeFileSync(outcomesPath, JSON.stringify(outcomes, null, 2));

const stats = {
  total: tracking.length,
  offers: tracking.filter((t) => t.status === 'offer').length,
  rejections: tracking.filter((t) => t.status === 'rejection').length,
  interviews: tracking.filter((t) => t.status === 'interview' || t.status === 'screening').length,
  noResponse: tracking.filter((t) => t.status === 'no_response').length,
  responseRate: tracking.length ? (tracking.length - tracking.filter((t) => t.status === 'no_response').length) / tracking.length : 0,
};

console.log(JSON.stringify({ success: true, data: { entry, stats, trackingPath, outcomesPath } }));
`,
    },
    inputSchema: {
      type: 'object',
      properties: {
        profileId: { type: 'string', default: 'default', description: 'Identifier of the career profile to update (default: "default").' },
        jobId: { type: 'string', description: 'Identifier of the job application.' },
        status: { type: 'string', enum: ['offer', 'rejection', 'interview', 'screening', 'no_response', 'withdrawn'], description: 'Current application outcome or stage.' },
        company: { type: 'string', description: 'Company associated with the application.' },
        role: { type: 'string', description: 'Role or job title associated with the application.' },
        salaryOffered: { type: 'number', description: 'Salary offered for the position.' },
        notes: { type: 'string', description: 'Additional notes about the outcome.' },
        date: { type: 'string', description: 'Date the outcome occurred, in ISO 8601 format.' },
      },
    },
    outputSchema: {
      type: 'object',
      properties: {
        success: { type: 'boolean', description: 'Whether the outcome was recorded' },
        entry: { type: 'object', description: 'The recorded outcome entry' },
        stats: { type: 'object', description: 'Aggregated career search statistics' },
        trackingPath: { type: 'string', description: 'File path where tracking was stored' },
      },
      required: ['success', 'entry', 'stats', 'trackingPath'],
