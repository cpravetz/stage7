        submitUrlTemplate: { type: 'string', description: 'URL template for submitting applications (supports {jobId}, {applyUrl} placeholders)' },
        submitMethod: { type: 'string', enum: ['POST', 'GET', 'PUT'], default: 'POST', description: 'HTTP method for submitting applications' },
