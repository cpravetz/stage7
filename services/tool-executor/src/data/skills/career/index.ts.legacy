  {
    id: 'career_add_portal',
    name: 'Add Portal',
    description:
      'Register a job portal configuration (base URL, search URL template, selectors, auth) so the scrape tool can target it. Supports custom portals and company career pages.',
    type: 'code',
    manifest: {
      language: 'javascript',
      entrypoint: 'index.js',
      sourceCode: `
const input = __tool_input || {};
const fs = require('fs');
const path = require('path');

const baseDir = process.env.CAREER_HOME || path.join('/tmp/career');
const id = input.id || input.name || 'portal_' + Date.now();
const name = input.name || id;
const baseUrl = input.baseUrl || '';
const searchUrlTemplate = input.searchUrlTemplate || '';
const selectors = input.selectors || {};
const auth = input.auth || {};
const enabled = input.enabled !== false;

if (!baseUrl && !searchUrlTemplate) {
  console.log(JSON.stringify({ success: false, error: 'Either baseUrl or searchUrlTemplate is required' }));
  process.exit(0);
}

const portalsPath = path.join(baseDir, 'applications', 'portals.json');
const portals = fs.existsSync(portalsPath) ? JSON.parse(fs.readFileSync(portalsPath, 'utf8')) : [];
const idx = portals.findIndex((p) => p.id === id);
const portal = {
  id,
  name,
  baseUrl,
  searchUrlTemplate,
  selectors,
  auth,
  submitUrlTemplate: input.submitUrlTemplate || '',
  submitMethod: (input.submitMethod || 'POST').toUpperCase(),
  submitBodyTemplate: input.submitBodyTemplate || '',
  submitHeaders: input.submitHeaders || {},
  enabled,
  createdAt: new Date().toISOString(),
  updatedAt: new Date().toISOString(),
};
if (idx >= 0) portals[idx] = portal;
else portals.push(portal);
fs.writeFileSync(portalsPath, JSON.stringify(portals, null, 2));

console.log(JSON.stringify({ success: true, data: { portal, portalsPath, totalPortals: portals.length } }));
`,
