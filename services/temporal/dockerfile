FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ libvips-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY package*.json ./
COPY shared-nextgen/package*.json ./shared-nextgen/
COPY services/temporal/package*.json ./services/temporal/
COPY services/temporal/tsconfig.json ./services/temporal/
COPY shared-nextgen/tsconfig.json ./shared-nextgen/
COPY services/temporal/src ./services/temporal/src/

RUN --mount=type=cache,target=/root/.npm npm ci --legacy-peer-deps --ignore-scripts

COPY shared-nextgen/src ./shared-nextgen/src/

RUN cd shared-nextgen && npx tsc
RUN cd services/temporal && rm -rf dist && npx tsc

WORKDIR /usr/src/app/services/temporal

EXPOSE 4100

CMD ["node", "dist/index.js"]