# Build on top of pre-built base image
FROM cktmcs:base

# Copy service package.json first for workspace registration
COPY services/missioncontrol/package.json ./services/missioncontrol/

# Install service dependencies
RUN npm install --legacy-peer-deps --workspace=services/missioncontrol

# Copy service source code
COPY services/missioncontrol/ ./services/missioncontrol/

# Build the service
RUN npm run build --workspace=services/missioncontrol

# Set working directory to the service's folder
WORKDIR /usr/src/app/services/missioncontrol

EXPOSE 5030

CMD ["node", "dist/MissionControl.js"]
