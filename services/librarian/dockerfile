# Build on top of pre-built base image
FROM cktmcs:base

# Copy service package.json first for workspace registration
COPY services/librarian/package.json ./services/librarian/

# Install service dependencies
RUN npm install --legacy-peer-deps --workspace=services/librarian

# Copy service source code
COPY services/librarian/ ./services/librarian/

# Build the service
RUN npm run build --workspace=services/librarian

# Set working directory to the service's folder
WORKDIR /usr/src/app/services/librarian

EXPOSE 5040

CMD ["node", "dist/Librarian.js"]
