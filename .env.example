# .env.example
#
# Example environment variables for Stage7 (NextGen services).
# Copy this file to '.env' and fill in real values for the keys.
#
# Only variables actually consumed via process.env by NextGen service
# source code (services/*/src, shared-nextgen/src, frontend-nextgen/src)
# are listed below. Per-service consumption is mapped in env.summary.

#########################################################
# Core                                                  #
#########################################################

# Node.js environment (e.g., 'production', 'development')
NODE_ENV=production

# Node.js runtime options (e.g., memory limits). Consumed by the Node
# runtime itself, not by application code.
NODE_OPTIONS="--max-old-space-size=4096"

# Logical name of this service instance
SERVICE_NAME=stage7

# Per-service listen port. Each service defaults to its documented port
# (gateway 3000, brain 3100, worker-pool 3200, mcp-runtime 3300,
# agent-runtime 3400, tool-executor 3500, temporal 4100, vault 4000,
# artifacts 4200, auth 4300); override per container as needed.
# PORT=3000

# CodeExecutor and the probe sandbox read PATH when executing subprocesses.
# Do not override it here; listed only because application code reads it.

#########################################################
# Redis                                                 #
#########################################################

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

#########################################################
# MongoDB                                               #
#########################################################

MONGO_URI=mongodb://mongo:27017
MONGO_DB=stage7

# Mongo driver server-selection timeout (ms). Default: 5000.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

#########################################################
# Internal Service URLs                                 #
#########################################################

# Temporal service (Stage7's workflow/watch runner).
TEMPORAL_HTTP_URL=http://temporal:4100

# Task queue TemporalClient starts watch workflows on. Default: stage7-watch.
TEMPORAL_TASK_QUEUE=stage7-watch

ARTIFACTS_URL=http://artifacts:4200
GATEWAY_URL=http://gateway:3000
WORKER_POOL_URL=http://worker-pool:3200
MCP_RUNTIME_URL=http://mcp-runtime:3300/mcp
TOOL_EXECUTOR_URL=http://tool-executor:3500
AGENT_RUNTIME_URL=http://agent-runtime:3400
AUTH_URL=http://auth:4300

# Legacy alias consulted when ARTIFACTS_URL is unset. Prefer ARTIFACTS_URL.
PERSISTENCE_URL=

# Assistant ("brain") service. Used by ReasoningExecutor and ToolExecutor for
# reasoning delegation, and by skill-level fallbacks. Skills that fall back to a
# direct brain call SKIP the call entirely when this is empty, so an unset value
# never produces a dial to a port nothing serves.
BRAIN_URL=http://brain:3100

# Brain service timeout controls. Agent Runtime waits for the configured Brain
# completion deadline plus a 30-second response grace period.
#
# BRAIN_PROVIDER_ATTEMPT_TIMEOUT_MS: per-attempt ceiling for a single provider
#   call to an LLM endpoint (ms). Default: 660000.
#
# BRAIN_COMPLETION_DEADLINE_MS: total time budget for a Brain completion
#   across candidate models and providers (ms). Default: 1800000. Must be at
#   least a few times BRAIN_PROVIDER_TIMEOUT_MS, otherwise the budget is
#   spent on one slow provider and no other eligible model is ever tried.
#
# BRAIN_PROVIDER_TIMEOUT_MS: lower-level HTTP fetch timeout per provider
#   request (ms). Default: 600000. Used by providerFetch() for the raw HTTP
#   call; BRAIN_PROVIDER_ATTEMPT_TIMEOUT_MS wraps the full provider.complete()
#   call (which may include additional internal retries on the provider side).
#   Must stay below BRAIN_PROVIDER_ATTEMPT_TIMEOUT_MS so the request is not
#   cut short by the attempt ceiling.
#
# BRAIN_CIRCUIT_THRESHOLD: consecutive provider-level fatal errors (401/403/
#   auth/quota) before a provider's circuit breaker opens. Default: 8.
#
# BRAIN_CIRCUIT_COOLDOWN_MS: how long a tripped circuit breaker stays open
#   before half-open retry. Default: 60000.
#
# BRAIN_MODEL_COOLDOWN_MAX_MS: ceiling on how long a model stays in cooldown
#   after a failure (ms). Default: 86400000 (24h).
BRAIN_PROVIDER_ATTEMPT_TIMEOUT_MS=660000
BRAIN_COMPLETION_DEADLINE_MS=1800000
BRAIN_PROVIDER_TIMEOUT_MS=600000
BRAIN_CIRCUIT_THRESHOLD=8
BRAIN_CIRCUIT_COOLDOWN_MS=60000
BRAIN_MODEL_COOLDOWN_MAX_MS=86400000

# Agent Runtime request timeout (ms). Default: BRAIN_COMPLETION_DEADLINE_MS
# plus 60s, or 900000 when that is unset.
AGENT_RUNTIME_TIMEOUT_MS=1860000

# Mission approval controls (temporal service).
#
# APPROVAL_TIMEOUT_MS: how long a mission waits for human approval.
#   Default: 86400000 (24h).
# APPROVAL_POLL_INTERVAL_MS: approval polling interval (ms). Default: 3000.
APPROVAL_TIMEOUT_MS=86400000
APPROVAL_POLL_INTERVAL_MS=3000

# Watch-scheduler polling interval (ms). Default: 60000.
WATCH_SCHEDULER_POLL_MS=60000

# mcp-runtime wait budget for tool-executor to become reachable at boot (ms).
# Default: 2000.
TOOL_EXECUTOR_STARTUP_TIMEOUT_MS=2000

#########################################################
# Assistant Selection                                    #
#########################################################

# Comma-separated list of assistant IDs to deploy/load.
# Leave empty to load all canonical assistants.
# Example: STAGE7_ASSISTANTS=cto-canonical-assistant,hr-canonical-assistant
STAGE7_ASSISTANTS=

# Optional comma-separated allowlist of tenant IDs permitted to use harness
# learning. Empty means all tenants are allowed. Default: empty.
HARNESS_LEARNING_TENANTS=

#########################################################
# LLM Providers                                         #
#########################################################

# A provider registers only when its credential is present; an unset key
# removes that provider from the router rather than failing calls.

CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_WORKERS_AI_ACCOUNT_ID=

# OpenAI (OpenAI-hosted or proxied)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_LIST_MODELS_PATH=/models
OPENAI_CHAT_PATH=/chat/completions
OPENAI_COMPLETIONS_PATH=/completions

# OpenRouter
OPENROUTER_LIST_MODELS_PATH=/models
OPENROUTER_CHAT_PATH=/chat/completions
OPENROUTER_COMPLETIONS_PATH=/completions
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_URL=https://openrouter.ai/api/v1

# Mistral
MISTRAL_API_KEY=
MISTRAL_API_BASE=https://api.mistral.ai/v1
MISTRAL_LIST_MODELS_PATH=/models
MISTRAL_CHAT_PATH=/chat/completions
MISTRAL_COMPLETIONS_PATH=/completions

# Grok / xAI. Either GROK_API_KEY or XAI_API_KEY enables the provider.
GROK_API_KEY=
XAI_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_LIST_MODELS_PATH=/models
GROK_CHAT_PATH=/chat/completions
GROK_COMPLETIONS_PATH=/completions

# Gemini API. Either GEMINI_API_KEY or GOOGLE_API_KEY enables the provider.
# The endpoint is hardcoded in the provider; there is no URL variable.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Hugging Face router. Either HUGGINGFACE_API_KEY or HF_TOKEN enables it.
HUGGINGFACE_API_KEY=
HF_TOKEN=
HUGGINGFACE_API_BASE=https://router.huggingface.co/v1
HUGGINGFACE_LIST_MODELS_PATH=/models
HUGGINGFACE_CHAT_PATH=/chat/completions
HUGGINGFACE_COMPLETIONS_PATH=/completions

# NVIDIA NIM (build.nvidia.com). Every account gets a block of free API credits;
# the endpoint is metered once they are spent.
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_LIST_MODELS_PATH=/models
NVIDIA_CHAT_PATH=/chat/completions
NVIDIA_COMPLETIONS_PATH=/completions

# OpenWebUI (self-hosted Open WebUI / Ollama proxy). Either OPENWEB_URL or
# OPENWEBUI_URL enables the provider; a trailing /v1 is stripped. The
# OPENWEB_* path variables are checked first, then the OPENWEBUI_* ones.
OPENWEB_URL=
OPENWEBUI_URL=
OPENWEBUI_API_KEY=
OPENWEB_LIST_MODELS_PATH=/api/models
OPENWEB_CHAT_PATH=/api/chat/completions
OPENWEB_COMPLETIONS_PATH=/api/completions
OPENWEBUI_LIST_MODELS_PATH=/models
OPENWEBUI_CHAT_PATH=/chat/completions
OPENWEBUI_COMPLETIONS_PATH=/completions

# Anthropic (endpoint is hardcoded to https://api.anthropic.com)
ANTHROPIC_API_KEY=

# Ollama (local or remote). Either OLLAMA_API_BASE or OLLAMA_URL enables it;
# a missing /v1 suffix is appended.
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_URL=
OLLAMA_API_KEY=
OLLAMA_LIST_MODELS_PATH=/models
OLLAMA_CHAT_PATH=/chat/completions
OLLAMA_COMPLETIONS_PATH=/completions

#########################################################
# Custom LLM Providers                                   #
#########################################################

# Comma-separated list of third-party provider prefixes.
# Each prefix must have a corresponding _API_KEY, _API_NAME, and _API_URL env var.
# Providers are expected to be OpenAI-compatible (OpenAPI standards).
# Example: CUSTOM_PROVIDERS=REQUESTY,LLM7
CUSTOM_PROVIDERS=

# For each prefix <PREFIX> defined above, set:
#   <PREFIX>_API_KEY   - The API key for the provider
#   <PREFIX>_API_NAME  - Display name for the provider
#   <PREFIX>_API_URL   - Base URL of the OpenAI-compatible API (e.g. https://router.requesty.ai/v1)
#   <PREFIX>_LIST_MODELS_PATH - Override the model listing path (default: /models)
#
# Example for REQUESTY:
# REQUESTY_API_KEY=rqstry-sk-...
# REQUESTY_API_NAME=Requesty
# REQUESTY_API_URL=https://router.requesty.ai/v1

#########################################################
# Assistant Persistence                                  #
#########################################################

# Shared assistant storage path used by tool-executor and CodeExecutor.
# Unset values fall back to /tmp/stage7 (or per-skill /var/data/stage7/... paths).
ASSISTANT_HOME=

#########################################################
# Tool Executor Stores and Local Paths                   #
#########################################################

# Filesystem stores (skill/tool/trigger records) with Mongo-backed remotes.
# Remote calls time out after the *_TIMEOUT_MS values; on timeout the local
# file store is used. Defaults create directories under /tmp.
SKILL_STORE_DIR=
SKILL_STORE_TIMEOUT_MS=3000
TOOL_STORE_DIR=
TRIGGER_STORE_DIR=
TRIGGER_STORE_TIMEOUT_MS=3000
EXECUTION_RECORD_DIR=
EXECUTION_RECORD_TIMEOUT_MS=3000
EVENT_LOG_DIR=
EVENT_LOG_TIMEOUT_MS=3000

# Tool permissioning stores (audit log, grants/denials, permission requests).
# Defaults live under /tmp/stage7-tool-*.
TOOL_AUDIT_LOG_DIR=
TOOL_GRANT_STORE_DIR=
TOOL_DENIAL_STORE_DIR=
TOOL_PERMISSION_REQUEST_STORE_DIR=

# Local paths used by executors. Defaults under /tmp.
FILE_STORAGE_BASE_PATH=
CALENDAR_BASE_PATH=
STAGE7_SANDBOX_DIR=
STAGE7_PROBE_WORK_DIR=
PLUGIN_DEPLOY_DIR=

# Python interpreter for code/plugin execution. Default: python3.
PYTHON_BIN=python3

# MCP server config file read by the mcpServers routes. Default:
# /tmp/stage7-mcp/mcp-servers.json
MCP_CONFIG_PATH=

# MCP tool-discovery sources. Default source is MCP_RUNTIME_URL; provide a
# JSON array to override, e.g.
#   MCP_DISCOVERY_SOURCES=[{"name":"local","url":"http://localhost:3300/mcp"}]
MCP_DISCOVERY_SOURCES=

# Set to the literal string "true" to let tool discovery probe containerized
# tools on the Docker network. Anything else, including unset, keeps discovery
# local.
TOOL_DISCOVERY_NETWORK=false

# Base URL for the ApiClient executor when a skill does not provide one.
API_CLIENT_BASE_URL=

#########################################################
# Search and Scraping                                    #
#########################################################

# External SearXNG instance (not part of the shipped compose file).
SEARXNG_URL=

# Google Programmable Search credentials.
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# LangSearch API.
LANGSEARCH_API_KEY=
LANGSEARCH_API_URL=https://api.langsearch.com

#########################################################
# Vault                                                 #
#########################################################

# Master key used by the Vault service. Generate a long random string
# in production (e.g. `openssl rand -hex 32`).
MASTER_KEY=

# Base URL of the Vault service for credential/secret lookups.
# Used by CredentialProvider and ToolConfigResolver to resolve
# vault:// references and tool secrets. Defaults to http://vault:4000
# when unset (Docker Compose service name). Set to http://localhost:4000
# when running services outside Docker Compose with port mapping.
VAULT_URL=http://localhost:4000

# Default tenant used by Vault when a request does not carry one.
# Default: system.
VAULT_DEFAULT_TENANT=

#########################################################
# Artifacts Storage                                      #
#########################################################

# Filesystem storage root for artifacts. Takes precedence over S3 when set.
ARTIFACTS_LOCAL_DIR=

# Public URL prefix served for files in ARTIFACTS_LOCAL_DIR.
ARTIFACTS_LOCAL_BASE_URL=

# S3-compatible storage. Credentials fall back to AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY when the ARTIFACTS_S3_* variants are unset.
ARTIFACTS_S3_BUCKET=
ARTIFACTS_S3_REGION=us-east-1
ARTIFACTS_S3_ENDPOINT=
ARTIFACTS_S3_ACCESS_KEY_ID=
ARTIFACTS_S3_SECRET_ACCESS_KEY=

#########################################################
# Auth (seed administrator)                              #
#########################################################

# Seed administrator created on first boot when no user with that email
# exists. The default password is public; set both before exposing the stack.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Tenant assigned to the seed administrator. Default: tenant-1.
ADMIN_TENANT=tenant-1

#########################################################
# Logging                                               #
#########################################################

LOG_LEVEL=info
