# .env.example
#
# Example environment variables for Stage7 (NextGen services).
# Copy this file to '.env' and fill in real values for the keys.
#
# Only variables actually consumed via process.env by NextGen service
# source code (services/*/src, shared-nextgen/src, frontend-nextgen/src)
# are listed below.

#########################################################
# Core                                                  #
#########################################################

# Node.js environment (e.g., 'production', 'development')
NODE_ENV=production

# Node.js runtime options (e.g., memory limits)
NODE_OPTIONS="--max-old-space-size=4096"

# Logical name of this service instance
SERVICE_NAME=stage7

#########################################################
# Redis                                                 #
#########################################################

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

#########################################################
# MongoDB                                               #
#########################################################

MONGO_URI=mongodb://mongo:27017
MONGO_DB=stage7

#########################################################
# Temporal & Workflow Services                           #
#########################################################

TEMPORAL_ADDRESS=temporal:4100
ARTIFACTS_URL=http://artifacts:4200
GATEWAY_URL=http://gateway:3000

#########################################################
# Internal Service URLs                                 #
#########################################################

WORKER_POOL_URL=http://worker-pool:3200

# Assistant ("brain") service. Used by ReasoningExecutor and ToolExecutor for
# reasoning delegation, and by skill-level fallbacks. Skills that fall back to a
# direct brain call SKIP the call entirely when this is empty, so an unset value
# never produces a dial to a port nothing serves.
BRAIN_URL=http://brain:3100

# Per-request ceiling for a single reasoning call to the brain (ms).
# NOTE: this currently defaults to 60000, which equals the 60s nginx
# proxy_read_timeout on /api. Any skill chaining reasoning calls inside that
# window can still be 504'd by the proxy; lower this (e.g. 20000-30000) once
# reviewed.
BRAIN_REQUEST_TIMEOUT_MS=60000

# Skill-level brain fallback budget, used only by the career interview skills.
# Must stay well under both BRAIN_REQUEST_TIMEOUT_MS and the skill's manifest
# timeoutMs, since the skill emits a not-connected result when it expires.
#
# A run is sequential per topic (delegation first, direct brain call only if the
# delegation produced nothing), so the worst case is the SUM of the two per-topic
# deadlines. 24000 + 19000 = 43000 must stay under CAREER_BATTLECARD_BUDGET_MS.
#
# The fallback default is 19000, not 10000, because observed brain latency for
# these prompts is 16-19s. A 10s abort tears down only the client socket, so the
# brain went on to complete and log a full-duration OK while the skill discarded
# the answer and reported itself offline.
CAREER_DELEGATED_TIMEOUT_MS=24000
CAREER_BRAIN_FALLBACK_TIMEOUT_MS=19000
# Outer emit deadline, kept under the manifest timeoutMs (52000) so the graceful
# not-connected flush still runs before CodeExecutor SIGKILLs the child.
CAREER_BATTLECARD_BUDGET_MS=44000
CAREER_MOCK_INTERVIEW_BUDGET_MS=30000

#########################################################
# Assistant Selection                                    #
#########################################################

# Comma-separated list of assistant IDs to deploy/load.
# Leave empty to load all canonical assistants.
# Example: STAGE7_ASSISTANTS=cto-canonical-assistant,hr-canonical-assistant
STAGE7_ASSISTANTS=

#########################################################
# LLM Providers                                         #
#########################################################

CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_WORKERS_AI_ACCOUNT_ID=

# OpenAI (OpenAI-hosted or proxied)
OPENAI_API_KEY=
OPENAI_LIST_MODELS_PATH=/models
OPENAI_CHAT_PATH=/chat/completions
OPENAI_COMPLETIONS_PATH=/completions

# OpenRouter
OPENROUTER_LIST_MODELS_PATH=/models
OPENROUTER_CHAT_PATH=/chat/completions
OPENROUTER_COMPLETIONS_PATH=/completions
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_URL=https://openrouter.ai/api/v1

# Mistral
MISTRAL_LIST_MODELS_PATH=/models
MISTRAL_CHAT_PATH=/chat/completions
MISTRAL_COMPLETIONS_PATH=/completions
MISTRAL_API_KEY=


# Grok / xAI
GROK_LIST_MODELS_PATH=/models
GROK_CHAT_PATH=/chat/completions
GROK_COMPLETIONS_PATH=/completions
GROK_API_KEY=

# Gemini API
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta


# Hugging Face router
HUGGINGFACE_LIST_MODELS_PATH=/models
HUGGINGFACE_CHAT_PATH=/chat/completions
HUGGINGFACE_COMPLETIONS_PATH=/completions
HUGGINGFACE_API_KEY=

# NVIDIA NIM (build.nvidia.com). Every account gets a block of free API credits;
# the endpoint is metered once they are spent.
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_LIST_MODELS_PATH=/models
NVIDIA_CHAT_PATH=/chat/completions
NVIDIA_COMPLETIONS_PATH=/completions

# OpenWebUI (self-hosted Open WebUI / Ollama proxy)
# Typical OpenWebUI exposes OpenAI-compatible chat at POST /api/chat/completions
OPENWEB_URL=
OPENWEBUI_API_KEY=
OPENWEB_LIST_MODELS_PATH=/api/models
OPENWEB_CHAT_PATH=/api/chat/completions
OPENWEB_COMPLETIONS_PATH=/api/completions

# Anthropic-compatible passthrough (when proxied via OpenWebUI or other proxies)
# e.g. POST /api/v1/messages
ANTHROPIC_MESSAGES_PATH=/api/v1/messages
ANTHROPIC_API_KEY=

# Ollama (local or remote)
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_LIST_MODELS_PATH=/models
OLLAMA_CHAT_PATH=/chat/completions
OLLAMA_COMPLETIONS_PATH=/completions

# Ollama proxy passthrough base (some deployments expose Ollama under /ollama/api)
# Example: /ollama/api/* will be proxied to native Ollama endpoints.
OLLAMA_PROXY_BASE=/ollama/api

#########################################################
# Custom LLM Providers                                   #
#########################################################

# Comma-separated list of third-party provider prefixes.
# Each prefix must have a corresponding _API_KEY, _API_NAME, and _API_URL env var.
# Providers are expected to be OpenAI-compatible (OpenAPI standards).
# Example: CUSTOM_PROVIDERS=REQUESTY,LLM7
CUSTOM_PROVIDERS=

# For each prefix <PREFIX> defined above, set:
#   <PREFIX>_API_KEY   - The API key for the provider
#   <PREFIX>_API_NAME  - Display name for the provider
#   <PREFIX>_API_URL   - Base URL of the OpenAI-compatible API (e.g. https://router.requesty.ai/v1)
#   <PREFIX>_LIST_MODELS_PATH - Override the model listing path (default: /models)
#
# Example for REQUESTY:
# REQUESTY_API_KEY=rqstry-sk-...
# REQUESTY_API_NAME=Requesty
# REQUESTY_API_URL=https://router.requesty.ai/v1

#########################################################
# Vault                                                 #
#########################################################

# Master key used by the Vault service. Generate a long random string
# in production (e.g. `openssl rand -hex 32`).
MASTER_KEY=

#########################################################
# Logging                                               #
#########################################################

LOG_LEVEL=info
